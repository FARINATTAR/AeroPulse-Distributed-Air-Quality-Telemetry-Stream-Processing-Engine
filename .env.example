# AeroPulse Environment Variables Template
ENVIRONMENT=development
LOG_LEVEL=INFO
COLLECTION_INTERVAL_MINUTES=5

# API Keys (Get free keys from OpenWeatherMap & AQICN)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
WAQI_API_KEY=your_waqi_api_key_here

# Kafka Brokers
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# TimescaleDB / Postgres Connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aeropulse
POSTGRES_USER=aeropulse_admin
POSTGRES_PASSWORD=aeropulse_secure_2026
